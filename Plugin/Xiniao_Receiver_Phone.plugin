[Script]
http-response ^https:\/\/gateway\.56xiniao\.com\/app\/practice\/app\/waybill\/receiverPhone script-path=https://raw.githubusercontent.com/tlsftlsftlsf/Loon-Plugins/main/Script/xiniao_receiver_phone.js, requires-body=true, tag=喜鸟提取手机号

[Mitm]
hostname = gateway.56xiniao.com
