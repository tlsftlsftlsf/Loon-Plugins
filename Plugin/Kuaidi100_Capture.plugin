#!name = 快递100凭据自动捕获
#!desc = 自动捕获快递100 (kuaidihelp.com) 面单记录与物流查询请求的 ts、sign、Cookie 及 Headers 凭据，并保存至持久化存储，支持 Loon 本地通知及 Bark 推送。
#!openUrl = https://github.com/tlsftlsftlsf/Loon-Plugins
#!author = tlsftlsftlsf
#!tag = 快递100, 凭据获取, 抓包
#!icon = https://gitlab.com/lodepuly/iconlibrary/-/raw/main/App_icon/120px/KuaiDi100.png
#!date = 2026-11-08 18:08:00

[Script]
http-request ^https?:\/\/api[0-5]?\.kuaidihelp\.com\/.*(getWaybillRecord|getStatusByWaybillNo) script-path=https://raw.githubusercontent.com/tlsftlsftlsf/Loon-Plugins/main/Script/kuaidi100_capture.js, requires-body=true, tag=快递100凭据捕获

[Mitm]
hostname = api*.kuaidihelp.com, *.kuaidihelp.com
